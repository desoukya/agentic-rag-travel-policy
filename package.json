{
  "name": "agentic-engineering-practice",
  "private": true,
  "packageManager": "yarn@4.3.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -pt run build",
    "check": "yarn workspaces foreach -pt run check",
    "dev:ingestion": "DOTENV_CONFIG_PATH=.env.ollama yarn workspace ingestion-consumer dev",
    "dev:langchain": "DOTENV_CONFIG_PATH=.env.ollama yarn workspace langchain-rag dev",
    "dev:langgraph": "DOTENV_CONFIG_PATH=.env.ollama yarn workspace langgraph-rag dev"
  }
}
